# Server
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# AI Configuration
LOG_LEVEL=info
MAX_TOKENS=2000
MAX_REQUEST_SIZE=10kb
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
CLIENT_ORIGIN=http://localhost:3000

# Remote API access is disabled by default. If enabled, use a long random token
# and send it as `Authorization: Bearer <token>` from the remote API client.
ALLOW_REMOTE_ACCESS=false
# GAIA_API_TOKEN=replace-with-a-long-random-token
