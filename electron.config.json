{
  "productName": "Gaia Core AI",
  "appId": "com.gaia.core.ai",
  "directories": {
    "buildResources": "build",
    "output": "dist-electron"
  },
  "files": ["dist/**/*", "electron-main.js", "preload.cjs", "package.json"],
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis", "portable"]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Development"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
